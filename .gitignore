# ==========================================
# Mail-Sending Clients — Root Git Ignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/
out/
web-build/

# Testing and coverage
coverage/
*.lcov
.nyc_output

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and IDE directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Mobile / React Native / Expo
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Android / iOS local builds
android/.gradle/
android/app/build/
ios/Pods/
ios/build/

# TypeScript / Linters / Vite caches
*.tsbuildinfo
.eslintcache
.prettiercache
*.timestamp-*-*.mjs
.vite/

# Temporary files
tmp/
temp/
